{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
